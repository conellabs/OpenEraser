{
  "name": "@conellabs/open-eraser",
  "version": "0.0.1",
  "description": "Deterministic renderer for Mermaid flowcharts with Eraser-quality output. Pure Node — no browser in the build.",
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/conellabs/OpenEraser.git"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "build:lib": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepack": "pnpm build:lib",
    "pipeline": "tsx scripts/pipeline.ts",
    "icon-sheet": "tsx scripts/icon-sheet.ts",
    "gen-vocab": "tsx scripts/gen-vocab.ts",
    "build": "tsx scripts/build-artifact.ts",
    "demo-artifact": "tsx scripts/demo-artifact.ts"
  },
  "dependencies": {
    "elkjs": "^0.11.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.1",
    "tsx": "^4.22.4",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  }
}
